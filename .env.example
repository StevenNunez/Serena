# Copia este archivo a .env.local (local) o cárgalo en el hosting (producción). Nunca subas valores reales.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Tienda que se abre en la raíz del dominio y dirección pública
NEXT_PUBLIC_DEFAULT_TENANT=serena
NEXT_PUBLIC_SITE_URL=https://serena.teolabs.app

# Correos (SMTP)
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
# EMAIL_REPLY_TO=

# Cron de limpieza y avisos (Vercel lo envía como "Authorization: Bearer ...")
CRON_SECRET=

# Avisos en el celular: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@teolabs.app

# Solo para pruebas: la cuenta demo recibe sus correos en la casilla de la dueña del proyecto
# DEMO_EMAIL=
# OWNER_EMAIL=
